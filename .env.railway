# Copy these to Railway Dashboard → Your Service → Variables

# Required Variables
SECRET_KEY=django-insecure-CHANGE-THIS-TO-RANDOM-50-CHARS
DEBUG=False
ALLOWED_HOSTS=.railway.app

# Database - Use Railway's variable reference
# In Railway, set this to ${MYSQL_URL} using the dropdown
DATABASE_URL=${MYSQL_URL}

# Optional: Email Configuration
# Uncomment and configure if you need email functionality
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@blooddonor.com
